<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="modelgate"/>
    <springProperty scope="context" name="LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <!-- ===== 控制台输出（开发环境） ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId}] %logger{50} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== 滚动文件（生产环境，JSON 格式方便 ELK 采集） ===== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.log</file>
        <!-- 按时间+大小滚动。
             ⚠️ 不要写回 TimeBasedRollingPolicy + SizeAndTimeBasedFNATP 的老组合：
             logback 1.5 下 SizeAndTimeBasedFNATP 已弃用，启动时会打 4 行 WARN 状态信息。
             SizeAndTimeBasedRollingPolicy 内部就是这两者的组合，行为完全等价。 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>512MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}"}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
            </fieldNames>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>apiKey</includeMdcKeyName>
            <includeMdcKeyName>owner</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ===== 异步写文件（不阻塞主链路） =====
         ⚠️ neverBlock 必须显式设为 true。AsyncAppender 的默认值是 **false**，
         也就是「队列满时阻塞调用方」——而调用方在本项目里很可能就是 Netty 事件循环线程。
         一旦磁盘抖动或日志突增把 512 的队列打满，写日志就会卡住事件循环，
         连累该 EventLoop 上的**所有连接**。这与本项目"绝不阻塞转发"的硬约束直接冲突。
         配上 discardingThreshold=0 (永不按级别丢弃) 之后，这个阻塞风险反而是最高的：
         什么都不丢、满了就只能等。

         现在的取舍：宁可丢日志，也不能卡转发。
           queueSize          2048  —— 容纳更长的突发
           discardingThreshold 256  —— 剩余容量低于 256 时优先丢弃 INFO/DEBUG，保住 WARN/ERROR
           neverBlock         true  —— 彻底填满时直接丢弃，绝不阻塞调用线程
           includeCallerData  false —— 显式声明。它默认就是 false，但一旦有人打开，
                                       每条日志都要抓一次调用栈，开销是数量级的增长 -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>256</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- ===== 异步控制台 =====
         ConsoleAppender 的写入是 synchronized 的，且容器里 stdout 往往被日志驱动接管，
         对端一慢就会反压到调用线程。同步挂在 root 上等于给热路径埋了个阻塞点，
         所以这里同样包一层 Async。

         另外注意：CONSOLE 与 FILE **同时**挂在 root 上，意味着每条日志被格式化两次、
         写两次（一次 PatternLayout、一次 LogstashEncoder）。文件已是 ELK 采集口径，
         若确认容器侧不从 stdout 采集日志，可以直接把 root 里的 ASYNC_CONSOLE 去掉，
         省掉整整一份格式化开销。这里保留是因为去掉属于可观测性行为变更，需要你确认采集方式。 -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>256</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <!-- ===== 单一固定配置，不使用 Spring Profile 机制 =====
         2026-08-18 压测优化清理：此前这里按 springProfile 分 dev/local/default 与 prod 两块，
         与本项目"全项目不使用 Spring Profile"（见 11-变更记录.md §19）的既定方向矛盾——
         且 default 未显式设置 spring.profiles.active 时，Spring 会把字面量 "default" 视为隐式激活，
         导致 dev/local/default 那块（业务包 DEBUG）在未设置任何 Profile 的情况下始终生效，
         每个请求多打若干条 DEBUG 日志，是压测持续负载下长尾延迟的次要贡献因素之一。
         控制台 + 文件双写（此前仅挂 CONSOLE，导致 logs/modelgate.log 恒为空，无法回溯排查）。 -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>

    <!-- 降低框架自身 DEBUG 日志噪音 -->
    <logger name="org.springframework.cloud.gateway" level="WARN"/>
    <logger name="reactor.netty" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
    <logger name="com.netflix" level="WARN"/>
</configuration>
