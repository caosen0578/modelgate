<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 3.5.6 / Spring 6.2.11 / JDK 17，对齐内网 framework-bom 2.0.0（spring6）。
      合入内网时此 parent 换成 com.pab:super-pom + com.pab.framework:framework-bom:2.0.0。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.pab.ficc.ibp</groupId>
    <artifactId>modelgate</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>ModelGate</name>
    <description>AI Model API Gateway</description>

    <properties>
        <java.version>17</java.version>

        <!--
          ⚠️ 内网 framework-bom 2.0.0 定义的是 2025.0.0.0（四段，内网定制坐标）。
          此处用 Maven Central 可解析的 2025.0.0（同代）以保证外网可编译验证；
          合入内网时改为 2025.0.0.0，或直接由 framework-bom 统一管理、删掉本属性。
        -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>

        <!-- 以下版本对齐 framework-bom 2.0.0（spring6）。
             属性名必须与 spring-boot-dependencies 的定义一致才会覆盖生效，
             Jackson 由 jackson-bom 统一管理，属性名是 jackson-bom.version（不是 jackson.version）。 -->
        <jackson-bom.version>2.19.2</jackson-bom.version>
        <logback.version>1.5.18</logback.version>
        <slf4j.version>2.0.17</slf4j.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <!-- ⚠️ com.mysql:mysql-connector-j 新坐标从 8.0.31 起在 Maven Central 发布，
             8.0.30 仍是旧坐标 mysql:mysql-connector-java，此处必须 ≥ 8.0.31 -->
        <mysql.version>8.0.33</mysql.version>
        <jedis.version>3.1.0</jedis.version>

        <!-- Boot 3 专用坐标：与 Boot 2 的 artifactId 不同，见下方依赖注释 -->
        <!-- ⚠️ mybatis-plus-jsqlparser 独立模块从 3.5.9 起才发布到 Maven Central，
             starter 与 jsqlparser 模块版本必须保持一致，故此处 ≥ 3.5.9 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <!-- 内网无 springdoc，仅保留 swagger 注解；2.2.0 与内网既有工程一致 -->
        <swagger-annotations.version>2.2.0</swagger-annotations.version>
        <logstash-encoder.version>8.0</logstash-encoder.version>

        <caffeine.version>3.1.8</caffeine.version>
        <!-- 内网框架统一使用 Druid（非 HikariCP），2026-08-18 压测优化改用 -->
        <druid.version>1.2.28</druid.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!--<dependency>
            <groupId>com.pab.ficc.ibp</groupId>
            <artifactId>ibp-web</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>-->
        <dependency>
            <groupId>com.pab.ficc.ibp</groupId>
            <artifactId>ibp-domain</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.pab.ficc.ibp</groupId>
            <artifactId>ibp-mybatis</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- ===== Spring Cloud Gateway (WebFlux 响应式) =====
             ⚠️ Gateway 4.3.0（Spring Cloud 2025.0.x）起坐标一分为二（webflux / webmvc），
             旧坐标 spring-cloud-starter-gateway 已弃用，下个大版本移除。沿用旧坐标会在启动时打两段告警：
               · spring-cloud-starter-gateway 内的 StarterDeprecatedAutoConfiguration 无条件打印
               · spring-cloud-gateway-server 内的 GatewayClassPathWarningAutoConfiguration 打印，
                 其条件是 @ConditionalOnMissingClass("...gateway.server.webflux.Marker")
             新坐标 spring-cloud-starter-gateway-server-webflux 会带入只含 Marker 类的
             spring-cloud-gateway-server-webflux，两段告警随之消失。
             注：spring-cloud-gateway-server（真正装着全部网关类）仍会作为传递依赖存在，属正常，勿再手工排除。

             ⚠️ 该新 starter 还会传递带入 spring-boot-properties-migrator（compile 作用域，会进 fat jar）。
             它负责把弃用属性名在运行时映射到新名，正是旧前缀 spring.cloud.gateway.* 仍能生效的原因。
             本项目 yml 已全用新前缀 spring.cloud.gateway.server.webflux.*，启动时它不打印任何内容；
             **保留不排除**——内网 dev/prod 的配置不在本仓库，若那边仍有旧前缀，排除掉会让路由静默失效。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!-- 【已移除】com.ctrip.framework.apollo:apollo-client
             行内不需要本项目自行引入 Apollo：此前只是占位，ApolloConfig 除了打变更日志没做任何事，
             实际生效的配置一直来自配置文件。移除后同时规避了 apollo-client 对 Boot 3 的兼容性未知。
             配置中心若确需接入，走内网 halo-config-apollo，不由本项目声明依赖。 -->

        <!-- ===== Redis =====
             内网 com.pab.framework:redis 无法外网解析，已用精简源码桩 CacheProvider.java（仅
             get/setex/del/incr/incrBy/expire/set）替代。桩上只允许出现 Redis 原生命令的标准签名
             （内网 CacheProvider 底层就是 jedis，照抄 jedis 签名），加内网没有的方法会导致合入时编译失败。
             ⚠️ 内网 Redis 禁用 Lua，桩里已无 eval，禁止恢复（见 spec/05 §2.3、spec/11 §31）。
             合入内网时删桩并恢复：
        <dependency>
            <groupId>com.pab.framework</groupId>
            <artifactId>redis</artifactId>
        </dependency>
        -->
        <!-- 本地 Redis 客户端（local Profile 直连本地 Redis）；
             版本对齐 BOM：内网 redis 组件 0.6.x 要求 jedis 3.1.0 -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
        </dependency>
        <!-- 数据源连接池：Druid（内网框架统一用它，非 HikariCP）。
             手工构建 DruidDataSource Bean（ServiceConfiguration.java），不用 druid-spring-boot-3-starter，
             避免其自动装配与本项目手工 Bean 方式冲突——与 Redis/Jedis 手工构建 CacheProvider 的既有模式一致。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- ===== MyBatis Plus =====
             ⚠️ Boot 3 必须用 mybatis-plus-spring-boot3-starter：
             原 mybatis-plus-boot-starter 的自动装配写在 spring.factories（Boot 2 机制），
             Boot 3 改用 AutoConfiguration.imports，沿用旧坐标会导致 Mapper 全部注入失败。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
            <exclusions>
                <!-- starter 默认传递依赖 HikariCP，本项目连接池统一用 Druid，排除避免误用 -->
                <exclusion>
                    <groupId>com.zaxxer</groupId>
                    <artifactId>HikariCP</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 【已移除】com.baomidou:mybatis-plus-jsqlparser
             该独立模块**从 3.5.9 才开始发布**，本项目现锁 3.5.7，Maven Central 上没有 3.5.7 的坐标，
             留着会直接 "Could not find artifact ... mybatis-plus-jsqlparser:jar:3.5.7" 构建失败。
             3.5.7 的 PaginationInnerInterceptor 与 jsqlparser 依赖仍在 mybatis-plus-extension 内
             （由 starter 传递引入），无需单独声明。
             ⚠️ 若日后把 mybatis-plus.version 升回 ≥3.5.9，**必须把这段依赖加回来**，否则分页拦截器缺类。 -->
        <!-- Boot 3 起 MySQL 驱动坐标改为 com.mysql:mysql-connector-j，旧坐标 mysql:mysql-connector-java 已废弃 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!-- ===== 本地缓存 Caffeine ===== -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <!-- ===== 熔断器 Resilience4j =====
             ⚠️ 坐标由 resilience4j-spring-boot2 换成 -spring-boot3，同样是自动装配机制变更 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- ===== Actuator =====
             【已移除】io.micrometer:micrometer-registry-prometheus —— 决策：本项目不接 Prometheus/Grafana。
             随之删除的还有 metrics/GatewayMetrics、AuditService 的 Gauge/Counter 埋点、
             /actuator/prometheus 端点暴露。可观测性改为全部落在日志上（详见 11 §16）。

             ⚠️ actuator 本身**保留**：/actuator/health 是 K8s liveness/readiness 探针的依赖
             （见 10 §3），与 Prometheus 无关，删掉会直接导致 Pod 起不来。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Reactor 上下文传播（MDC traceId 跨线程） =====
             WebFlux 下请求在 Netty 事件循环组装、阻塞逻辑在 boundedElastic 执行，
             MDC 这种 ThreadLocal 不会自动跟随，导致日志 traceId 全空且会串号。
             本包让 Reactor 在每次线程切换时自动搬运已登记的 ThreadLocal，
             由 config/ReactorContextPropagationConfig 注册 MDC 访问器后生效。
             36KB，无任何传递依赖。⚠️ 合入内网需确认该坐标可用，缺失会导致启动失败。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
            <version>1.1.3</version>
        </dependency>

        <!-- ===== 参数校验 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== Jackson Java8 时间类型支持 ===== -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- ===== JSON 日志编码器（logback-spring.xml 的 FILE appender 用，ELK 采集） ===== -->
        <!-- ⚠️ 7.x 对应 logback 1.2/1.3；BOM 的 logback 1.5.18 + slf4j 2.0.17 需要 8.x，
             否则 FILE appender 初始化即 NoClassDefFoundError -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-encoder.version}</version>
        </dependency>

        <!-- ===== Lombok ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== 配置处理器（IDE 自动提示） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== Swagger 注解 =====
             【已移除】org.springdoc:springdoc-openapi-starter-webflux-ui —— 内网仓库无此包。
             随之失去的能力：在线 Swagger UI（/swagger-ui.html）与 /v3/api-docs 文档生成。
             接口契约以 spec/modelgate/04-接口与数据结构.md 为准。

             注解本身保留（Controller 上的 @Tag/@Operation/@Parameter 是有效的接口说明），
             故显式引入 swagger-annotations；版本取 2.2.0，与内网既有工程一致。
             ⚠️ 若内网连此包也没有，则需一并删除全部 io.swagger.v3 注解（8 个 Controller）。 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
