<!-- 请求入口 -->
<mxCell id="100" value="&lt;b&gt;POST /v1/chat/completions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#a5b4fc'&gt;Authorization: Bearer {api_key} | AKSK {ak}:{timestamp}:{signature}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#4338ca;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1">
  <mxGeometry x="380" y="20" width="560" height="65" as="geometry"/>
</mxCell>

<!-- Filter 链外框 -->
<mxCell id="101" value="GlobalFilter 过滤器链（Spring Cloud Gateway · WebFlux · Reactor Netty）" style="swimlane;startSize=32;fillColor=#f8faff;strokeColor=#818cf8;fontColor=#4338ca;fontStyle=1;fontSize=12;rounded=1;arcSize=3;" vertex="1" parent="1">
  <mxGeometry x="220" y="105" width="880" height="680" as="geometry"/>
</mxCell>

<!-- F1: AdminAuthFilter -->
<mxCell id="110" value="&lt;font color='#991b1b'&gt;&lt;b&gt;order = -200&lt;/b&gt;&lt;/font&gt;　　&lt;b&gt;AdminAuthFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;保护 /admin/** 和 /actuator/**，IP 白名单 → X-Admin-Token → Basic Auth 三层验证&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="101">
  <mxGeometry x="25" y="50" width="810" height="62" as="geometry"/>
</mxCell>
<mxCell id="110r" value="→ 401 / 403" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#991b1b;fontStyle=1;fontSize=11;" vertex="1" parent="101">
  <mxGeometry x="840" y="50" width="30" height="62" as="geometry"/>
</mxCell>

<!-- F2: CredentialAuthFilter -->
<mxCell id="111" value="&lt;font color='#92400e'&gt;&lt;b&gt;order = -190&lt;/b&gt;&lt;/font&gt;　　&lt;b&gt;CredentialAuthFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;API Key → SHA256 → Caffeine L1 → Redis L2 → DB L3；AK/SK → HMAC重签 → 时间戳防重放(±5min)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="101">
  <mxGeometry x="25" y="128" width="810" height="62" as="geometry"/>
</mxCell>
<mxCell id="111r" value="→ 401" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#92400e;fontStyle=1;fontSize=11;" vertex="1" parent="101">
  <mxGeometry x="840" y="128" width="30" height="62" as="geometry"/>
</mxCell>

<!-- F3: AppAccessControlFilter -->
<mxCell id="112" value="&lt;font color='#78350f'&gt;&lt;b&gt;order = -180&lt;/b&gt;&lt;/font&gt;　　&lt;b&gt;AppAccessControlFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;加载访问规则（Caffeine），校验客户端 IP 是否匹配 CIDR / IP 白名单；规则为空则不限制&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="101">
  <mxGeometry x="25" y="206" width="810" height="62" as="geometry"/>
</mxCell>
<mxCell id="112r" value="→ 403" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#78350f;fontStyle=1;fontSize=11;" vertex="1" parent="101">
  <mxGeometry x="840" y="206" width="30" height="62" as="geometry"/>
</mxCell>

<!-- F4: ModelAuthFilter -->
<mxCell id="113" value="&lt;font color='#14532d'&gt;&lt;b&gt;order = -170&lt;/b&gt;&lt;/font&gt;　　&lt;b&gt;ModelAuthFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;解析请求体 model 字段，查 mg_app_model_auth（Caffeine），校验：系统开关→授权开关→是否过期→模型状态&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="101">
  <mxGeometry x="25" y="284" width="810" height="62" as="geometry"/>
</mxCell>
<mxCell id="113r" value="→ 403/503" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#14532d;fontStyle=1;fontSize=11;" vertex="1" parent="101">
  <mxGeometry x="840" y="284" width="30" height="62" as="geometry"/>
</mxCell>

<!-- F5: RateLimitFilter -->
<mxCell id="114" value="&lt;font color='#1e3a8a'&gt;&lt;b&gt;order = -160&lt;/b&gt;&lt;/font&gt;　　&lt;b&gt;RateLimitFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Redis Lua 令牌桶（每秒滑动窗口），key = app_id，QPS 取自授权配置；超限返回 429 + Retry-After&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="101">
  <mxGeometry x="25" y="362" width="810" height="62" as="geometry"/>
</mxCell>
<mxCell id="114r" value="→ 429" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1e3a8a;fontStyle=1;fontSize=11;" vertex="1" parent="101">
  <mxGeometry x="840" y="362" width="30" height="62" as="geometry"/>
</mxCell>

<!-- F6: TraceFilter -->
<mxCell id="115" value="&lt;font color='#581c87'&gt;&lt;b&gt;order = -150&lt;/b&gt;&lt;/font&gt;　　&lt;b&gt;TraceFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;生成 traceId（UUID 前16位），写入 MDC 和响应头 X-Trace-Id、X-Mg-App、X-Mg-Model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#d8b4fe;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="101">
  <mxGeometry x="25" y="440" width="810" height="62" as="geometry"/>
</mxCell>

<!-- F7: ModelRouteFilter -->
<mxCell id="116" value="&lt;font color='#065f46'&gt;&lt;b&gt;order = -140&lt;/b&gt;&lt;/font&gt;　　&lt;b&gt;ModelRouteFilter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;加载 ModelInstance + ModelCredential（Caffeine 30s），调用 ProviderAdapter 转换请求体，设置 GATEWAY_REQUEST_URL_ATTR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="101">
  <mxGeometry x="25" y="518" width="810" height="62" as="geometry"/>
